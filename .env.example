# ShowBuzz environment template. Copy to .env.local for local development; on Vercel set the same
# variables per environment (Development / Preview / Production). Never commit real values.
# Validated by src/config/env.ts (server) and src/config/public-env.ts (NEXT_PUBLIC_* only).

# --- Required now -------------------------------------------------------------------------------

# MongoDB Atlas connection string (replica set, needed for transactions).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name, e.g. showbuzz_prod. Letters, digits, _ and - only.
MONGODB_DB=showbuzz

# Canonical site URL: cookies, links, SEO and the same-origin (CSRF) check. Required in production;
# defaults to http://localhost:3000 in development, so set it if you run the dev server on another port.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Added by later batches (not read yet) ----------------------------------------------------
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Batch 1.2: HMAC key for hashing OTP codes at rest.
OTP_HASH_SECRET=
# Batch 1.3: JWT signing keys (>= 32 bytes, different from each other).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Batch 3.6: HMAC-SHA256 key for signing ticket QR payloads.
QR_SIGNING_SECRET=

# Batch 3.4: payment gateway credentials (Razorpay or Cashfree, not decided yet).
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# OTP delivery (SMS/email) provider: names depend on the provider chosen before batch 1.9.
# OTP_PROVIDER_API_KEY=

# Media storage provider: names depend on the provider chosen.
# MEDIA_STORAGE_BUCKET=
