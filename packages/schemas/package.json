{
  "name": "@showbuzz/schemas",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas (single source of truth for input shapes), business constants and derived types.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@showbuzz/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
