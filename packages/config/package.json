{
  "name": "@showbuzz/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tooling: tsconfig bases, ESLint flat config, Prettier options and the Vitest preset.",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./eslint": "./eslint.mjs",
    "./prettier": "./prettier.mjs",
    "./vitest": "./vitest/preset.mjs",
    "./vitest/*": "./vitest/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mongod": "node vitest/ensure-mongod.mjs"
  },
  "dependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint-config-next": "catalog:",
    "mongodb-memory-server": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": "*",
    "next": "*",
    "prettier": "*",
    "vite": "*",
    "vitest": "*"
  }
}
