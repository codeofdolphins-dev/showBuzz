{
  "name": "@showbuzz/console-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Back-office UI kit shared by the admin and partner consoles: shell, page parts, form fields, data table, dialogs, toasts.",
  "exports": {
    "./theme.css": "./src/theme.css",
    "./nav": "./src/nav.ts",
    "./search-params": "./src/search-params.ts",
    "./action-errors": "./src/action-errors.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@showbuzz/schemas": "workspace:*",
    "@showbuzz/utils": "workspace:*",
    "lucide-react": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "*",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@showbuzz/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
