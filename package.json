{
  "name": "showbuzz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "turbo run format format:root",
    "format:check": "turbo run format:check format:check:root",
    "format:root": "prettier --write .",
    "format:check:root": "prettier --check .",
    "db:sync-indexes": "pnpm --filter @showbuzz/db db:sync-indexes",
    "db:seed": "pnpm --filter @showbuzz/db db:seed",
    "db:seed-roles": "pnpm --filter @showbuzz/admin db:seed-roles",
    "db:create-admin": "pnpm --filter @showbuzz/admin db:create-admin",
    "db:seed-demo-admin": "pnpm --filter @showbuzz/admin db:seed-demo-admin",
    "db:create-vendor-user": "pnpm --filter @showbuzz/partner db:create-vendor-user",
    "db:seed-demo-vendors": "pnpm --filter @showbuzz/partner db:seed-demo-vendors",
    "web": "pnpm --filter @showbuzz/web dev",
    "admin": "pnpm --filter @showbuzz/admin dev",
    "partner": "pnpm --filter @showbuzz/partner dev"
  },
  "devDependencies": {
    "@showbuzz/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
