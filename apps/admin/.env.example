# ShowBuzz Admin environment template. Copy to .env.local for local development; on Vercel set the same
# variables per environment in the admin project. Never commit real values.
# Validated by packages/runtime/src/env.ts, admin-auth-env.ts and public-env.ts.

# MongoDB: the same cluster and database as the public app (staff and roles live next to users).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=showbuzz

# This app's own origin: links and the same-origin (CSRF) check. Required in production
# (https://admin.showbuzz.com); locally the admin dev server runs on port 3001.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# HS256 keys for staff access / refresh tokens (>= 32 characters each, different from each other and from
# the public app's JWT_* keys).
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=

# Shared with the public and partner apps: authorises POST /api/internal/revalidate on the public app, which
# refreshes showbuzz.com after an edit here (>= 32 characters, same value in every app).
REVALIDATE_SECRET=
# Where this app reaches the public app server-to-server (cache refresh). Required in production
# (https://showbuzz.com); defaults to http://localhost:3000.
WEB_APP_URL=http://localhost:3000
