{
  "name": "@showbuzz/partner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:create-vendor-user": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/create-vendor-user.ts",
    "db:seed-demo-vendors": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/seed-demo-vendors.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@showbuzz/console-ui": "workspace:*",
    "@showbuzz/core": "workspace:*",
    "@showbuzz/db": "workspace:*",
    "@showbuzz/runtime": "workspace:*",
    "@showbuzz/schemas": "workspace:*",
    "@showbuzz/utils": "workspace:*",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@showbuzz/config": "workspace:*",
    "@tailwindcss/turbopack": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
