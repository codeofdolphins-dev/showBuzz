# ShowBuzz Partner environment template. Copy to .env.local for local development; on Vercel set the same
# variables per environment in the partner project. Never commit real values.
# Validated by packages/runtime/src/env.ts, partner-auth-env.ts, otp-env.ts, revalidate-env.ts, web-app-env.ts,
# ticket-env.ts and public-env.ts.

# MongoDB: the same cluster and database as the public and admin apps (vendors own the catalogue they sell).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=showbuzz

# This app's own origin: links and the same-origin (CSRF) check. Required in production
# (https://partner.showbuzz.com); locally the partner dev server runs on port 3002.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# HS256 keys for vendor-user access / refresh tokens (>= 32 characters each, different from each other and from
# the public app's JWT_* and the admin app's ADMIN_JWT_* keys).
PARTNER_JWT_ACCESS_SECRET=
PARTNER_JWT_REFRESH_SECRET=

# HMAC key for one-time codes at rest (signup mobile verification), >= 32 characters. May differ from the public
# app's value: a code is only checked by the app that sent it.
OTP_HASH_SECRET=
# How codes are delivered: "appdoot" = sent over SMS by Appdoot (credentials below); "none" (default) = written
# to the server log and shown on screen outside production; "dev" = on screen only, not allowed in production.
OTP_PROVIDER=appdoot

# Appdoot transactional SMS (dashboard -> app credentials). Required when OTP_PROVIDER=appdoot; the same
# credentials as the public app (one Appdoot app serves both).
APPDOOT_APP_ID=
APPDOOT_SECRET_KEY=
# DLT-registered template whose only variable {{1}} is the code (optional, default "authentication").
# APPDOOT_OTP_TEMPLATE_ID=authentication

# Shared with the public and admin apps: authorises POST /api/internal/revalidate on the public app (>= 32 chars).
REVALIDATE_SECRET=
# Where this app reaches the public app server-to-server (cache refresh). Required in production
# (https://showbuzz.com); defaults to http://localhost:3000.
WEB_APP_URL=http://localhost:3000

# Ticket QR signing key (>= 32 characters). MUST be the same value as the public app's QR_SIGNING_SECRET: Scan Tickets
# verifies the QR codes showbuzz.com issues, and counter sales issue the same QR tickets.
QR_SIGNING_SECRET=

# Payment gateway. Partner never charges online (counter sales are recorded, not processed), but vendor
# cancellations refund through it, so it needs the same credentials as the web app.
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
