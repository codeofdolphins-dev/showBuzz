# ShowBuzz environment template. Copy to .env.local for local development; on Vercel set the same
# variables per environment (Development / Preview / Production). Never commit real values.
# Validated by packages/runtime/src/env.ts (server) and packages/runtime/src/public-env.ts (NEXT_PUBLIC_* only).

# --- Required now -------------------------------------------------------------------------------

# MongoDB Atlas connection string (replica set, needed for transactions).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name, e.g. showbuzz_prod. Letters, digits, _ and - only.
MONGODB_DB=showbuzz

# Canonical site URL: cookies, links, SEO and the same-origin (CSRF) check. Required in production;
# defaults to http://localhost:3000 in development, so set it if you run the dev server on another port.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# HMAC key for hashing OTP codes at rest (>= 32 characters).
OTP_HASH_SECRET=

# How sign-in codes are delivered while no SMS/email provider is chosen (optional, default "none"):
#   none = code written to the server log (and shown on screen outside production)
#   dev  = shown on screen only, never logged; not allowed in production
# OTP_PROVIDER=none

# HS256 keys for customer access / refresh tokens (>= 32 characters each, and different).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# HMAC-SHA256 key for signing ticket QR payloads (>= 32 characters). The admin app needs the same value to
# verify tickets at the gate. Changing it invalidates every QR already issued.
QR_SIGNING_SECRET=

# Shared secret for POST /api/internal/revalidate: the admin and partner apps send it to refresh this site's
# cached catalogue after an edit (>= 32 characters, same value in all three apps).
REVALIDATE_SECRET=

# Payment gateway. "simulated" confirms payments on the server without charging anything (the payment page
# then shows "Demo payment"); "razorpay" opens Razorpay Checkout and needs the credentials below.
PAYMENT_PROVIDER=razorpay

# Razorpay API keys (Dashboard -> Account & Settings -> API Keys). Test keys start with rzp_test_.
# The key id also reaches the browser to open Checkout; the secret never leaves the server.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
# Webhook signing secret (Dashboard -> Settings -> Webhooks), for POST /api/v1/webhooks/razorpay.
# Optional: without it the webhook answers 401 and confirmation relies on the browser handshake alone.
PAYMENT_WEBHOOK_SECRET=

# --- Added by later batches (not read yet) ----------------------------------------------------

# OTP delivery (SMS/email) provider: names depend on the provider chosen before batch 1.9.
# OTP_PROVIDER_API_KEY=

# Media storage provider: names depend on the provider chosen.
# MEDIA_STORAGE_BUCKET=
